# Copy to .env and fill in. NEVER commit your real .env or paste keys in chat.
SARVAM_API_KEY=your_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1
# Leave empty to disable thinking mode (cheaper). Set to low/medium/high to enable.
SARVAM_REASONING_EFFORT=
# Output token budget. Must leave room for reasoning AND the final JSON,
# else the model returns an empty answer. Default 16384; lower to save cost.
SARVAM_MAX_TOKENS=16384
# Server log verbosity: INFO or DEBUG.
RESUME_AGENT_LOG_LEVEL=INFO
