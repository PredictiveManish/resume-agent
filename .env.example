# Copy to .env and fill in.
# NEVER commit .env, and never paste your key into chat or share it in a zip.
SARVAM_API_KEY=your_key_here

# --- Models -----------------------------------------------------------------
# sarvam-105b is Sarvam's only first-party chat model and the safe default.
# (Sarvam-M and Sarvam-30B are deprecated.)
SARVAM_MODEL=sarvam-105b
# Two-pass mode analysis model. Defaults to the SAME model: there is no cheaper
# non-beta Sarvam chat model. Leave as sarvam-105b unless you know otherwise.
SARVAM_FAST_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# --- Cost controls ----------------------------------------------------------
# Cap on output tokens. A runaway generation is the main way cost explodes.
SARVAM_MAX_TOKENS=4096
# Leave EMPTY to disable thinking mode (sarvam-105b). Thinking tokens bill as
# output tokens, so leaving this empty is the single biggest cost saving.
SARVAM_REASONING_EFFORT=
# 1 = higher-quality TWO-PASS mode (analysis call, then rewrite call).
# Empty/0 = default ONE consolidated call (cheapest, fewest tokens).
RESUME_AGENT_TWO_PASS=

# --- Other ------------------------------------------------------------------
RESUME_AGENT_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# ADVANCED: open-weight models (beta, opt-in only)
# ---------------------------------------------------------------------------
# Sarvam also serves GLM-5.3, Gemma 4 31B and DeepSeek V4.1 Flash on
# /v2/chat/completions with the same key and credits. Two important warnings:
#   1. They are BETA and your key must be whitelisted, or the API returns
#      "400 invalid_request_error" before the model runs.
#   2. GLM-5.3 and DeepSeek V4.1 Flash REASON on every call (billed as output),
#      and GLM-5.3 (₹126/₹390 per 1M) is MORE expensive than sarvam-105b.
# If you have beta access and want to try one, set e.g.:
#   SARVAM_MODEL=deepseekv4.1-flash     # 1M context, ₹25/₹105, reasons
#   SARVAM_MODEL=gemma4                 # no reasoning, ₹35/₹90
# The client routes open-weight models to /v2 automatically.
